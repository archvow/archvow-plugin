# SonarQube analysis of {{ project_name }} (generated by archvow with -a sonar=yes).
# The CI runs the tests first: they write coverage.xml and test-results.xml, read here.
sonar.projectKey={{ package }}
sonar.projectName={{ project_name }}
sonar.sources={{ src }}
sonar.tests=tests
sonar.python.version={{ python_version }}
sonar.python.coverage.reportPaths=coverage.xml
sonar.python.xunit.reportPath=test-results.xml
sonar.sourceEncoding=UTF-8
