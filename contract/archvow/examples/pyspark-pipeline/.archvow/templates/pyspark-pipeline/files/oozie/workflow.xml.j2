<?xml version="1.0" encoding="UTF-8"?>
<!--
  Oozie workflow of {{ package }}: create the tables, then run the pipeline.
  Generated by archvow (scheduler=oozie). Deploy to appPath in HDFS: entrypoint.sh, the entry
  point file, and what the package option of entrypoint.sh builds: the wheel (the code) and
  dist/ddl.zip (the table scripts). Values come from job.properties.
-->
<workflow-app name="{{ package }}" xmlns="uri:oozie:workflow:0.5">
    <start to="tables"/>

    <!-- Spark SQL scripts ddl/*.sql, in order (needs spark-sql on the node that runs it). -->
    <action name="tables">
        <shell xmlns="uri:oozie:shell-action:0.3">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <configuration>
                <property><name>mapred.job.queue.name</name><value>${queueName}</value></property>
            </configuration>
            <exec>entrypoint.sh</exec>
            <argument>--ddl</argument>
            <file>${appPath}/entrypoint.sh</file>
            <archive>${appPath}/dist/ddl.zip#ddl</archive>
        </shell>
        <ok to="run"/>
        <error to="fail"/>
    </action>

    <action name="run">
        <spark xmlns="uri:oozie:spark-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <master>yarn</master>
            <mode>cluster</mode>
            <name>{{ package }}</name>
            <jar>${appPath}/{{ src }}/{{ package }}/p4_entrypoints/${entryPoint}_main.py</jar>
            <spark-opts>--py-files ${appPath}/dist/{{ package }}-${packageVersion}-py3-none-any.whl --queue ${queueName} ${sparkOpts}</spark-opts>
            <!-- one <arg> per command-line argument of the entry point, e.g. <arg>input-path</arg> -->
        </spark>
        <ok to="end"/>
        <error to="fail"/>
    </action>

    <kill name="fail">
        <message>{{ package }} failed: [${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>
    <end name="end"/>
</workflow-app>
