"""Airflow DAG of {{ package }}: create the tables, then run the pipeline.

Generated by archvow (scheduler=airflow). Adapt the schedule and the
arguments, then deploy this file to Airflow's DAG folder. The tasks run
entrypoint.sh on a worker where the project is deployed in APP_DIR (an edge
node with spark-submit and spark-sql): the same commands as by hand.
"""

from datetime import UTC, datetime

from airflow import DAG

try:
    from airflow.providers.standard.operators.bash import BashOperator
except ImportError:  # Airflow 2
    from airflow.operators.bash import BashOperator

APP_DIR = "/opt/{{ package }}"  # where deployment puts the project
ENTRY_POINT = "{{ package }}"  # archvow component add entrypoint <name>
ARGUMENTS = ""  # its command-line arguments (archvow show)

with DAG(
    dag_id="{{ package }}",
    schedule="@daily",
    start_date=datetime(2026, 1, 1, tzinfo=UTC),
    catchup=False,
    tags=["archvow", "spark"],
) as dag:
    tables = BashOperator(
        task_id="tables",  # the Spark SQL scripts in ddl/, in order
        bash_command=f"{APP_DIR}/entrypoint.sh --ddl ",
    )
    run = BashOperator(
        task_id="run",
        bash_command=f"{APP_DIR}/entrypoint.sh {ENTRY_POINT} {ARGUMENTS}",
    )
    tables >> run
