# The usual commands of my-pipeline (generated by archvow; yours to extend).
# `make` alone lists them. PYTHON chooses the interpreter: make test PYTHON=python3.12
PYTHON ?= python3

.PHONY: help install check test test-fast package ddl clean

help:  ## list the commands
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  make %-10s %s\n", $$1, $$2}'

install:  ## install the development tools
	$(PYTHON) -m pip install -r requirements.txt

check:  ## what the Git hook runs: ruff, archvow check
	ruff check .
	ruff format --check .
	archvow check

test:  ## every test, with coverage and the reports CI keeps
	$(PYTHON) -m pytest --cov=src --cov-report=term-missing --cov-report=xml --junitxml=test-results.xml

test-fast:  ## unit tests only
	$(PYTHON) -m pytest -m "not integration"

package:  ## build the wheel (and ddl.zip) into dist/
	PYTHON=$(PYTHON) ./entrypoint.sh --package

ddl:  ## create the tables: the Spark SQL scripts in ddl/
	./entrypoint.sh --ddl

clean:  ## remove build and test leftovers
	rm -rf dist build src/*.egg-info .pytest_cache .coverage coverage.xml test-results.xml spark-warehouse metastore_db derby.log
