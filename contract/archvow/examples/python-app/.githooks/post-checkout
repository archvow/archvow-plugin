#!/bin/sh
# archvow: runs after `git switch` / `git checkout`. It only warns, never blocks (the pre-commit hook
# and CI refuse a commit on a badly named branch). Create branches with plain Git:
#   git switch -c feature/<ticket>-<short-name> develop
[ "$3" = 1 ] || exit 0   # a branch was checked out (not a single file)
[ "${ARCHVOW_BRANCH_NAMING-gitflow}" != none ] || exit 0
branch=$(git symbolic-ref --short -q HEAD || true)
case "$branch" in
    ""|main|master|develop) exit 0 ;;
esac
case "$branch" in
    feature/*|hotfix/*)
        echo "post-checkout: this project has no ticket pattern yet (how its tickets are written, e.g. FATTRIB-[0-9]+)." >&2
        echo "  Set it once (architects approve it): archvow init invoicing --force -a ticket_pattern='FATTRIB-[0-9]+'" >&2 ;;
esac
if ! printf '%s\n' "$branch" | grep -Eq '^(feature|hotfix)/([A-Z][A-Z0-9]*-[0-9]+)-[A-Za-z0-9._-]+$|^release/[0-9]+([.][0-9]+)*$'; then
    echo "post-checkout: branch '$branch' does not follow the naming the commit hook and CI require:" >&2
    echo "  feature/<ticket>-<short-name> (e.g. feature/US-001-sales-reader), hotfix/<ticket>-<short-name>, release/<version>" >&2
    echo "  rename it now: git branch -m feature/US-001-<short-name>" >&2
fi
exit 0
