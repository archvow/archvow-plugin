# Packaging of {{ project_name }} (generated by archvow, template python-app): the package, its
# version, what it needs at run time and the settings of pytest and mypy. Raise the version for
# every release. Development tools are in requirements.txt, ruff's rules in ruff.toml.
# The src layout (code in {{ src }}/{{ package }}/) makes the tests run the installed package, never
# a copy that happens to sit in the working folder.
[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ package }}"
version = "0.1.0"
description = {{ description | tojson }}
requires-python = ">={{ python_version }}"
# What the program needs at run time: the packages approved with `-a dependencies=`, by their pip
# name (import yaml -> pyyaml). `init --force` writes this list again from the approvals.
{%- set pip_names = {"yaml": "pyyaml", "sklearn": "scikit-learn", "PIL": "pillow", "cv2": "opencv-python", "bs4": "beautifulsoup4", "dateutil": "python-dateutil", "dotenv": "python-dotenv", "jwt": "pyjwt"} %}
dependencies = [{% for dep in dependencies %}
    "{{ pip_names.get(dep, dep | replace('_', '-')) }}",{% endfor %}{% if dependencies %}
{% endif %}]

[tool.setuptools.packages.find]
where = ["{{ src }}"]

# Test settings - a guard: changing them needs the architects' approval (ARCH020 in merge
# requests). Markers are strict, so a mistyped invariant marker fails instead of giving no evidence.
[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["{{ src }}"]
addopts = "--strict-markers"
markers = [
    "invariant(id): the test of an archvow invariant (archvow show <component>, Invariants)",
    "decision(number): the test of a decision of the component's task (archvow prompt) (e.g. 3, or \"P1\")",
    "rule(id): the test of a project rule (e.g. \"R2\")",
    "example(name): the test of a business example, tests/examples/<component>/<name>/ (e.g. \"FATTRIB-012-paid\")",
    'integration: real files, a database or a fake transport in a temporary folder; skip with -m "not integration"',
]

# Type checks (make check): every function of the package is typed.
[tool.mypy]
python_version = "{{ python_version }}"
mypy_path = "{{ src }}"
packages = ["{{ package }}"]
disallow_untyped_defs = true
warn_unused_ignores = true
