# The usual commands of invoicing (generated by archvow; yours to extend).
# `make` alone lists them. PYTHON chooses the interpreter: make test PYTHON=python3.12
PYTHON ?= python3
CLI ?= main

.PHONY: help install check typecheck test test-fast run clean

help:  ## list the commands
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  make %-10s %s\n", $$1, $$2}'

install:  ## install the package (editable) and the development tools
	$(PYTHON) -m pip install -r requirements.txt

check:  ## what the Git hook runs, plus the type checks: ruff, mypy, archvow check, specs up to date
	ruff check .
	ruff format --check .
	@if [ -d src/invoicing ]; then $(PYTHON) -m mypy; else echo "mypy: no code yet"; fi
	archvow check
	archvow docs --check

typecheck:  ## the type checks only (mypy, settings in pyproject.toml)
	@if [ -d src/invoicing ]; then $(PYTHON) -m mypy; else echo "mypy: no code yet"; fi

test:  ## every test, with coverage and the reports CI keeps
	$(PYTHON) -m pytest --cov=src --cov-report=term-missing --cov-report=xml --junitxml=test-results.xml

test-fast:  ## unit tests only
	$(PYTHON) -m pytest -m "not integration"

run:  ## run a command line (CLI: the cli component's name, default main): make run CLI=invoices ARGS="--help"
	$(PYTHON) -m invoicing.p4_entrypoints.$(CLI)_cli $(ARGS)

clean:  ## remove build and test leftovers
	rm -rf dist build src/*.egg-info .pytest_cache .mypy_cache .coverage coverage.xml test-results.xml
