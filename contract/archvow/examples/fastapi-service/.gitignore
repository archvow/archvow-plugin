# archvow: the spec to read and the local status (archvow doc writes them; never committed)
.archvow/doc/

# Secrets: settings come from the environment, never from a committed file
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.coverage
coverage.xml
test-results.xml
htmlcov/

# Tool caches
.pytest_cache/
.ruff_cache/
.hypothesis/
.cache/

# OS and IDE
.DS_Store
.idea/
.vscode/

# archvow: how each AI agent last ran here, for the commit check (local)
.archvow/*.local

# archvow: what each business example's test really gave at its last run (local)
tests/examples/*/*/actual/
