# Packaging of {{ project_name }} (generated by archvow, template fastapi-service): the
# service's package, its version and what it needs at run time. Raise the version for every
# release. Development tools are in requirements.txt, ruff's rules in ruff.toml.
[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ package }}"
version = "0.1.0"
description = {{ description | tojson }}
requires-python = ">={{ python_version }}"
# What the service needs at run time, with the packages approved with `-a dependencies=`, by their
# pip name (import yaml -> pyyaml). `init --force` writes this list again from the approvals.
{%- set pip_names = {"yaml": "pyyaml", "sklearn": "scikit-learn", "PIL": "pillow", "cv2": "opencv-python", "bs4": "beautifulsoup4", "dateutil": "python-dateutil", "dotenv": "python-dotenv", "jwt": "pyjwt"} %}
dependencies = [
    "fastapi=={{ fastapi_version }}.*",
    "pydantic>=2",
    "pydantic-settings>=2",
    "uvicorn>=0.30",{% for dep in dependencies %}
    "{{ pip_names.get(dep, dep | replace('_', '-')) }}",{% endfor %}
]

[tool.setuptools.packages.find]
where = ["{{ src }}"]

# Test settings - a guard: changing them needs the architects' approval (ARCH020 in merge
# requests). Markers are strict, so a mistyped invariant marker fails instead of giving no evidence.
[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["{{ src }}"]
addopts = "--strict-markers"
markers = [
    "invariant(id): the test of an archvow invariant (archvow show <component>, Invariants)",
    "decision(number): the test of a decision of the component's task (archvow prompt) (e.g. 3, or \"P1\")",
    "rule(id): the test of a project rule (e.g. \"R2\")",
    "example(name): the test of a business example, tests/examples/<component>/<name>/ (e.g. \"FATTRIB-012-paid\")",
    'integration: through the app or a real database in a temporary folder; skip with -m "not integration"',
]
