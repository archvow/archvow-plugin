// archvow guards and tests of {{ project_name }} (generated by archvow, guard file).
// The gate nothing can skip: protect main and develop on your Git server (gitflow; no direct push,
// merge only through a pull/merge request whose build is green, approval of the architects
// {{ architects }} for .archvow/ and the guard files).
{%- if not ci_image or not pip_index_url %}
// WARNING: public sources in use ({% if not ci_image %}the agent's own Python{% endif %}{% if not ci_image and not pip_index_url %}, {% endif %}{% if not pip_index_url %}PyPI{% endif %}).
// For critical projects, re-run `archvow init` with -a ci_image=... -a pip_index_url=...
{%- endif %}
pipeline {
{%- if ci_image %}
    agent { docker { image '{{ ci_image }}' } }   // must contain Python {{ ci_python }}{% if ci_java %}, Java 17{% endif %} and git
{%- else %}
    agent any   // needs Python {{ ci_python }}{% if ci_java %}, Java 17{% endif %} and git on the agent
{%- endif %}
    options { timestamps() }
    environment {
        ARCHVOW_PIP_SPEC = 'archvow=={{ archvow_version }}'   // pinned: upgrade deliberately
{%- if pip_index_url %}
        PIP_INDEX_URL = '{{ pip_index_url }}'
{%- endif %}
        PATH = "${WORKSPACE}/.venv/bin:${env.PATH}"
    }
    stages {
        stage('Install tools') {
            steps {
                sh 'python3 -m venv .venv && pip install "$ARCHVOW_PIP_SPEC" "ruff>=0.6"'
            }
        }
        stage('Architecture') {
            steps {
                sh 'archvow check'          // code matches the spec, safety evidence, approved dependencies
                sh 'ruff check . && ruff format --check .'
            }
        }
{%- if branch_naming != 'none' %}
        stage('Branch name') {
            when { changeRequest() }   // gitflow: feature/<ticket>-<short-name>, hotfix/..., release/<version>
            steps {
                sh '''
                    echo "$CHANGE_BRANCH" | grep -Eq '{{ branch_regex }}|^(main|master|develop)$' ||
                        { echo "branch name must be feature/<ticket>-<short-name>, hotfix/<ticket>-<short-name> or release/<version>"; exit 1; }
                '''
            }
        }
{%- endif %}
        stage('Guards not weakened') {
            // pull / merge requests, except a release or a back-merge from main (already reviewed on develop)
            when { allOf { changeRequest(); not { anyOf { changeRequest branch: 'release/*'; changeRequest branch: 'main' } } } }
            steps {
                // ARCHITECTURE_APPROVED=true (a build parameter or job variable set by an architect)
                // accepts what the architects approved: weakened guards, a big change.
                sh '''
                    git fetch --no-tags origin "+refs/heads/$CHANGE_TARGET:refs/remotes/origin/$CHANGE_TARGET"
                    FLAGS=""
                    if [ "${ARCHITECTURE_APPROVED:-false}" = "true" ]; then FLAGS="--accept-weakening"; fi
                    archvow diff --base "origin/$CHANGE_TARGET" --markdown | tee spec-diff.md
                    archvow check --base "origin/$CHANGE_TARGET" $FLAGS
                '''
            }
        }
        stage('Tests') {
            when { expression { fileExists('tests') } }
            steps {
                sh '{{ install_command }}'
                sh 'pytest {{ cov_option }} --cov-report=term-missing --cov-report=xml --junitxml=test-results.xml'
                sh 'archvow check --test-report test-results.xml'   // every invariant's test ran and passed (ARCH046)
            }
            post {
                always { junit allowEmptyResults: true, testResults: 'test-results.xml' }
            }
        }
{%- if reviewers %}
        stage('AI review') {
            // An approved AI reviewer ({{ reviewers | join(', ') }}) reads the change and writes a report; it never
            // changes code (the stage fails if it does) and never reviews code written with its own tool.
            // HIGH findings fail until a person reads reviews/last-change.md and sets REVIEW_ACKNOWLEDGED=true.
            // The agent needs the reviewer's command line; credentials as Jenkins credentials{% if review_secrets %} exposed
            // as {{ review_secrets | join(', ') }} (withCredentials){% endif %}. Another command: ARCHVOW_REVIEW_COMMAND.
            when { allOf { changeRequest(); not { anyOf { changeRequest branch: 'release/*'; changeRequest branch: 'main' } } } }
            steps {
                sh '{{ install_command }}'
                sh '''
                    git fetch --no-tags origin "+refs/heads/$CHANGE_TARGET:refs/remotes/origin/$CHANGE_TARGET"
                    FLAGS=""
                    if [ "${REVIEW_ACKNOWLEDGED:-false}" = "true" ]; then FLAGS="--acknowledged"; fi
                    archvow review --base "origin/$CHANGE_TARGET" $FLAGS
                '''
            }
        }
{%- endif %}
{%- if sonar == 'yes' %}
        stage('SonarQube') {
            when { expression { fileExists('tests') } }
            steps {
                // 'SonarQube': the server's name in Manage Jenkins > System > SonarQube servers
                withSonarQubeEnv('SonarQube') { sh 'sonar-scanner' }
                timeout(time: 15, unit: 'MINUTES') { waitForQualityGate abortPipeline: true }
            }
        }
{%- endif %}
    }
    post {
        // coverage.xml (Cobertura) and test-results.xml are what SonarQube reads
        always { archiveArtifacts artifacts: 'spec-diff.md,coverage.xml,test-results.xml{% if reviewers %},reviews/last-change.md{% endif %}', allowEmptyArchive: true }
    }
}
