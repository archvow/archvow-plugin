  {
   "example": "pyspark-pipeline",
   "layers": {
    "p0_common": [
     {
      "type": "utility",
      "description": "Shared helper or constants module (no Spark actions, no I/O)."
     }
    ],
    "p1_domain": [
     {
      "type": "schema",
      "description": "Explicit StructType contract for a dataset."
     },
     {
      "type": "transformation",
      "description": "Pure, lazy DataFrame -> DataFrame function."
     }
    ],
    "p2_io": [
     {
      "type": "reader",
      "description": "Reads one dataset and enforces its schema."
     },
     {
      "type": "writer",
      "description": "Writes one dataset."
     }
    ],
    "p3_jobs": [
     {
      "type": "job",
      "description": "Orchestrates read -> transform -> write for one output."
     }
    ],
    "p4_entrypoints": [
     {
      "type": "entrypoint",
      "description": "Process entry point that parses arguments and runs one job."
     }
    ]
   }
  },
  {
   "example": "fastapi-service",
   "layers": {
    "p0_common": [
     {
      "type": "utility",
      "description": "A small helper every layer may use (no business rule, no I/O beyond what it says)."
     },
     {
      "type": "dependency",
      "description": "Something routes receive through Depends (the database session, the current user...)."
     }
    ],
    "p1_domain": [
     {
      "type": "model",
      "description": "A Pydantic model - the shape and the validation of one kind of data."
     },
     {
      "type": "error",
      "description": "A domain error - raised by services and the domain, mapped to an HTTP status by the app."
     },
     {
      "type": "logic",
      "description": "A pure business rule - a function of its inputs, no I/O."
     }
    ],
    "p2_io": [
     {
      "type": "repository",
      "description": "Stores and finds one kind of data (the database, or memory to start)."
     },
     {
      "type": "client",
      "description": "Calls one other service (HTTP API, message broker...)."
     }
    ],
    "p3_services": [
     {
      "type": "service",
      "description": "One business operation - calls repositories and clients, applies the rules, owns the transaction."
     }
    ],
    "p4_api": [
     {
      "type": "router",
      "description": "The HTTP routes of one resource - input, permissions, status codes, response."
     },
     {
      "type": "app",
      "description": "The FastAPI app - routers, prefix, lifespan, error mapping. Run with uvicorn --factory."
     }
    ]
   }
  },
