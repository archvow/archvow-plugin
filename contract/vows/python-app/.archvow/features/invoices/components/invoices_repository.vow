vow 1 component invoices_repository
# archvow vow of invoices_repository - what it must be and do; archvow check holds the code to it.
# Read: archvow show invoices_repository. Change: archvow specify invoices_repository. Never edit by hand.
name invoices
type repository
layer p2_io
module invoicing.p2_io.invoices_repository
ticket US-001
description "Stores and finds invoices, one JSON file per invoice in the data folder"
uses [invoice_model]

# --- symbols
symbol InvoicesRepository
  kind class

# --- decisions
decision 1
  question "Where and in which format is the data kept - e.g. one JSON file per invoice in data/invoices/, or a SQLite table?"
  answer "One file NUMBER.json in data_dir, the fields of the invoice, amount as a string"
  by noreply@anthropic.com
  on 2026-10-21T16:20:51.531837+00:00

decision 2
  question "Not found (e.g. get(\"F-42\") when it does not exist): return None, or raise which domain error?"
  answer "Return None; the service raises the domain error"
  by noreply@anthropic.com
  on 2026-10-21T16:20:51.850312+00:00

decision 3
  question "A crash while writing (e.g. the disk is full after half a file): how does a reader never see a half-written record - write to a temporary file then rename, or a transaction?"
  answer "Write to a temporary file next to it, then rename it"
  by noreply@anthropic.com
  on 2026-10-21T16:20:52.163044+00:00

decision 4
  question "Two runs write the same record at the same moment: the last one wins, the second one is refused, or the second one waits (a lock)?"
  answer "The last one wins: marking paid twice gives the same file"
  by noreply@anthropic.com
  on 2026-10-21T16:20:52.567662+00:00

assumptions []
answers
  P.retention
    answer "10 years (accounting law), then the file is deleted; one person's invoices are kept until then (legal obligation)"
    by noreply@anthropic.com
    on 2026-10-21T16:21:02.537432+00:00
  P.location
    answer "The company's file server, in France"
    by noreply@anthropic.com
    on 2026-10-21T16:21:02.820664+00:00

# --- hazards
hazard H1
  guide_word partial
  severity high
  never "An invoice file is half written"
  by noreply@anthropic.com
  on 2026-10-21T16:20:55.133888+00:00

# --- invariants
invariant INV1
  always "an invoice file is complete or absent"
  prevents [H1]
  verified_by example_test
  by noreply@anthropic.com
  on 2026-10-21T16:20:55.452690+00:00

# --- not applicable
not_applicable missing
  because "A missing file is reported as None, the service raises InvoiceNotFoundError (decision 2)"
  by noreply@anthropic.com
  on 2026-10-21T16:20:58.493972+00:00

not_applicable more
  because "It reads one invoice at a time, by number"
  by noreply@anthropic.com
  on 2026-10-21T16:20:58.793526+00:00

not_applicable stale
  because "Nothing is cached: every call reads the file"
  by noreply@anthropic.com
  on 2026-10-21T16:20:59.104422+00:00

not_applicable concurrent
  because "Concurrent writes give the same paid invoice (decision 4)"
  by noreply@anthropic.com
  on 2026-10-21T16:20:59.429100+00:00

not_applicable exposed
  because "Files stay in the data folder; nothing is logged"
  by noreply@anthropic.com
  on 2026-10-21T16:20:59.727068+00:00
