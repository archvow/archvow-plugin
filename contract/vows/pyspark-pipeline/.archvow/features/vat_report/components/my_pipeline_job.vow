name my_pipeline
type job
layer p3_jobs
module my_pipeline.p3_jobs.my_pipeline_job
ticket US-003
description "Read the orders, clean them, compute their VAT, write the result"
uses [orders_reader, clean_orders, compute_vat, vat_writer]

# --- symbols
symbol run_my_pipeline
  kind function
  signature "(spark: SparkSession, config: JobConfig) -> None"

# --- decisions
decision 1
  question "If one of its inputs is missing (e.g. the refunds file was not delivered): stop with an error, skip this run (nothing written), or continue without it?"
  answer "Fail"
  by architect@example.com
  on 2026-11-11T19:07:02.918672+00:00

decision 2
  question "If a run fails, is it retried automatically, how many times, and can a retry run after a half-finished run without duplicating data - e.g. 2 retries 10 minutes apart, the output is overwritten?"
  answer "No automatic retry; a re-run is safe (the writer overwrites)"
  by architect@example.com
  on 2026-11-11T19:07:03.145824+00:00

decision 3
  question "Which date does one run process (e.g. yesterday's data), and where does that date come from: an argument from the scheduler, or computed by the job?"
  answer "No run date: the job processes the input it is given"
  by architect@example.com
  on 2026-11-11T19:07:03.379962+00:00

assumptions []

# --- hazards
hazard H1
  guide_word missing
  severity high
  never "an absent, empty or late input is processed as if it were complete"
