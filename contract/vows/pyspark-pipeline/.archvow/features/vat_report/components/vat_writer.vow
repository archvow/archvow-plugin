vow 1 component vat_writer
# archvow vow of vat_writer - what it must be and do; archvow check holds the code to it.
# Read: archvow show vat_writer. Change: archvow specify vat_writer. Never edit by hand.
name vat
type writer
kind files
layer p2_io
module my_pipeline.p2_io.vat_writer
ticket US-003
description "Write the orders with their VAT as parquet"
uses [vat_schema]

# --- symbols
symbol write_vat
  kind function
  signature "(df: DataFrame, path: str) -> None"

# --- decisions
decision 1
  question "Output already exists (e.g. the job runs twice for the same date): overwrite, append, or fail?"
  answer "Overwrite"
  by architect@example.com
  on 2026-11-11T19:07:01.748316+00:00

decision 2
  question "If the job fails while writing (e.g. it stops after 3 of 10 files), how do readers avoid a half-written output: write to a temporary folder then rename, a _SUCCESS file, or a table transaction?"
  answer "Write to a temporary folder next to the output, then rename it"
  by architect@example.com
  on 2026-11-11T19:07:01.977915+00:00

decision 3
  question "If the job runs again on the same input (e.g. a re-run after a failure), must the output be exactly the same, with no duplicated rows?"
  answer "Yes: the same input gives the same output"
  by architect@example.com
  on 2026-11-11T19:07:02.203667+00:00

decision 4
  question "How is the output stored: which file format (parquet, csv...), and is it split into folders by a column (e.g. date=2026-10-12) or not?"
  answer "Parquet, not partitioned"
  by architect@example.com
  on 2026-11-11T19:07:02.431744+00:00

decision 5
  question "Does an approved shared library already write these files (e.g. acme_io.write_parquet, listed in requirements.txt)? Then the code calls it - which function - instead of writing them with Spark."
  answer "No: Spark writes them itself"
  by architect@example.com
  on 2026-11-11T19:07:02.657617+00:00

assumptions []

# --- hazards
hazard H1
  guide_word partial
  severity critical
  never "Downstream reads a half-written output"
  by architect@example.com
  on 2026-11-11T19:07:04.949885+00:00

hazard H2
  guide_word repeated
  severity high
  never "a re-run gives a different or duplicated result"
  by architect@example.com
  on 2026-11-11T19:07:11.410754+00:00

# --- invariants
invariant INV1
  always "the output folder is complete or absent"
  prevents [H1]
  verified_by runtime
  by architect@example.com
  on 2026-11-11T19:07:05.137453+00:00

invariant INV2
  prevents [H2]
  verified_by example_test
  from_decision 3
  by architect@example.com
  on 2026-11-11T19:07:11.435294+00:00

# --- not applicable
not_applicable exposed
  because "no personal data: every column of vat_schema is classified none"
  by architect@example.com
  on 2026-11-11T19:07:11.718454+00:00
